<?xml version="1.0" encoding="utf-8"?>
<!--
  La aplicacion de IIS que hace de reverse proxy al gateway.

  Va en la carpeta fisica de la aplicacion anidada (ej. C:\inetpub\bonificaciones), NO en la del
  sitio padre: IIS no mezcla la configuracion de una aplicacion con la del sitio ni con la de sus
  hermanas, asi que esto no toca nada de lo que ya funciona ahi — incluido MotorFiscal, que cuelga
  del mismo sitio.

  Requiere dos modulos que NO vienen con IIS: Application Request Routing (ARR) y URL Rewrite. En
  este servidor ya tienen que estar, porque MotorFiscal los usa; preparar-iis.ps1 lo verifica.

  IIS se queda con lo que sabe hacer bien: HTTPS, el certificado, el dominio y los logs de acceso.
  El gateway solo escucha en localhost y nunca se expone directo a internet.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!--
          ARR le saca a la URL el prefijo de la aplicacion (/api/bonificaciones) antes de que esta
          regla corra, asi que {R:1} es la ruta SIN el prefijo y el gateway ve /health, /admin/...,
          /v1/... como si estuviera en la raiz. Por eso el jar no necesita saber nada de la ruta
          anidada... salvo el panel, que arma URLs para el navegador: ese se compila con
          -PpanelBasePath=/api/bonificaciones/admin. Ver panel/next.config.mjs.
        -->
        <rule name="ApiBonificaciones" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://localhost:8081/{R:1}" />
        </rule>
      </rules>
    </rewrite>

    <!-- Sin esto el gateway ve todas las requests como HTTP desde 127.0.0.1 y los logs pierden la
         IP real de quien llamo — justo el dato que hace falta cuando una tienda reclama. -->
    <proxy enabled="true" preserveHostHeader="true" />

    <httpProtocol>
      <customHeaders>
        <!-- El panel de administracion no deberia poder ir en un iframe ajeno: es la superficie
             clasica de clickjacking sobre un panel. -->
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="same-origin" />
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

    <security>
      <requestFiltering>
        <!-- Un carrito de checkout son unos pocos KB. El default de IIS (30 MB) sobra, pero se
             baja igual: no hay ningun endpoint que reciba un archivo. -->
        <requestLimits maxAllowedContentLength="2097152" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
