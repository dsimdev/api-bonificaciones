# Credenciales de API por distribuidora. Copiar a .env (que esta en .gitignore) y completar con
# los valores de la coleccion Postman de cada distribuidora. NUNCA commitear el .env.
#
# PowerShell:  Get-Content .env | % { $k,$v = $_ -split '=',2; [Environment]::SetEnvironmentVariable($k,$v) }
# bash:        set -a && source .env && set +a

DYSSA_USER=
DYSSA_PASS=
SENDEROLASER_USER=
SENDEROLASER_PASS=
