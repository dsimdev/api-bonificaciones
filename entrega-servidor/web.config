<?xml version="1.0" encoding="utf-8"?>
<!--
  La aplicacion de IIS que hace de reverse proxy al gateway.

  Va en la carpeta fisica de la aplicacion anidada (C:\inetpub\bonificaciones), NO en la del sitio
  padre: este archivo solo aplica a /api/bonificaciones, asi que no cambia nada del sitio ni de
  MotorFiscal. (Al reves si: la aplicacion hereda la configuracion del sitio, como /api/impuestos.)

  Es, a proposito, la misma configuracion que el web.config de MotorFiscal, que ya funciona en este
  mismo sitio: lo que cambia es el puerto y el limite de tamanio.

  Requiere dos modulos que NO vienen con IIS: Application Request Routing (ARR) y URL Rewrite. En
  este servidor ya tienen que estar, porque MotorFiscal los usa; preparar-iis.ps1 lo verifica.

  IIS se queda con lo que sabe hacer bien: HTTPS, el certificado, el dominio y los logs de acceso.
  El gateway solo escucha en localhost y nunca se expone directo a internet.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!--
          La regla trabaja relativa a la aplicacion, asi que {R:1} es la ruta SIN el prefijo
          /api/bonificaciones y el gateway ve /health, /admin/...,
          /v1/... como si estuviera en la raiz. El jar de produccion (*-prod.jar) ya viene armado
          para esta ruta: por eso la aplicacion tiene que llamarse exactamente api/bonificaciones.
        -->
        <rule name="ApiBonificaciones" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://localhost:8081/{R:1}" />
        </rule>
      </rules>
    </rewrite>

    <!-- Conserva el Host original del pedido al pasarlo al gateway. Igual que en MotorFiscal. -->
    <proxy enabled="true" preserveHostHeader="true" />

    <httpProtocol>
      <customHeaders>
        <!-- El panel de administracion no deberia poder ir en un iframe ajeno: es la superficie
             clasica de clickjacking sobre un panel. -->
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="same-origin" />
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

    <security>
      <requestFiltering>
        <!-- Un carrito de checkout son unos pocos KB. El default de IIS (30 MB) sobra, pero se
             baja igual: no hay ningun endpoint que reciba un archivo. -->
        <requestLimits maxAllowedContentLength="2097152" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
